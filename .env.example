APP_NAME="E-Presensi BPRS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database: SQLite untuk development cepat; ganti ke MySQL/MariaDB untuk produksi (Hostinger).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=presensi
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false   # set true di produksi (HTTPS)
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Akun Admin awal untuk `php artisan db:seed` (kosongkan PASSWORD agar dibuat acak dan ditampilkan sekali).
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
